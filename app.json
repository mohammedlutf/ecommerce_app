{
  "expo": {
    "name": "زاد ماركت",
    "slug": "hadramout-ecommerce",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "favicon": "./assets/favicon.png",
    "userInterfaceStyle": "light",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "lang": "ar",
      "themeColor": "#004129",
      "backgroundColor": "#F8FAF9",
      "display": "standalone",
      "orientation": "any"
    },
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لتحديد عنوان التسليم بدقة على الخريطة.",
        "NSCameraUsageDescription": "نحتاج الكاميرا لالتقاط صور المنتجات التي تضيفها إلى المتجر.",
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول إلى معرض الصور لاختيار صور المنتجات."
      }
    },
    "android": {
      "allowRTL": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#E7F6EC"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.mohammedlutfdalal.hadramoutecommerce",
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": "1.0.0",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDBcAeAB-f9kfecvzFKZQgzENHsNuC27yo"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "extra": {
      "apiUrl": "http://192.168.1.33:8000",
      "eas": {
        "projectId": "1ea621da-1e71-4e8a-90e4-cd60b706ffcf"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      "./plugins/with-clean-splash.js",
      [
        "expo-build-properties",
        {
          "android": {
            "allowRTL": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نحتاج موقعك لتحديد عنوان التسليم بدقة على الخريطة."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول إلى معرض الصور لاختيار صور المنتجات.",
          "cameraPermission": "نحتاج الكاميرا لالتقاط صور المنتجات التي تضيفها إلى المتجر."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#004129",
          "defaultChannel": "default_v2",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/1ea621da-1e71-4e8a-90e4-cd60b706ffcf"
    }
  }
}