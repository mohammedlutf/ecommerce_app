{
  "expo": {
    "name": "زاد ماركت",
    "slug": "hadramout-ecommerce",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "favicon": "./assets/favicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لتحديد عنوان التسليم بدقة على الخريطة."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#E7F6EC"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.mohammedlutfdalal.hadramoutecommerce",
      "runtimeVersion": "1.0.0",
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "apiUrl": "http://192.168.1.34:8000",
      "eas": {
        "projectId": "1ea621da-1e71-4e8a-90e4-cd60b706ffcf"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E7F6EC",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
      "expo-build-properties",
      {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نحتاج موقعك لتحديد عنوان التسليم بدقة على الخريطة."
        }
      ]
    ],

    "updates": {
      "url": "https://u.expo.dev/1ea621da-1e71-4e8a-90e4-cd60b706ffcf"
    }
  }
}
